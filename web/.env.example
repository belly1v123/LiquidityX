# --- Backend (web/lib/server) ---
# Postgres connection string. Leave empty to use embedded PGlite (web/.data/pglite locally, /tmp/pglite on Vercel).
# On Vercel, set this (e.g. Neon) — /tmp is per-instance and is wiped, so PGlite there re-indexes from startBlock.
DATABASE_URL=
# Bearer token for POST /api/indexer/sync (Authorization: Bearer <INDEXER_SECRET>). Use a long random string.
INDEXER_SECRET=
# Vercel Cron sends Authorization: Bearer $CRON_SECRET; set it in Vercel to let the daily cron call the sync route.
CRON_SECRET=
# Optional server-side RPC override (defaults to the chain's RPC from web/lib/chain.ts).
MEZO_RPC_URL=

# --- Chain selection (shared) ---
# "local" = anvil 31337 at http://127.0.0.1:8545; anything else = Mezo testnet 31611.
NEXT_PUBLIC_CHAIN=

# Optional: put LiquidityX tables in their own schema when the database is shared (e.g. liquidityx)
DB_SCHEMA=
